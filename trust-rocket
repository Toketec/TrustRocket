#!/bin/bash
# TrustRocket CLI — 项目引导工具
# 子命令：init / migrate / preview / update
#
# 对标 SpecRocket 的 spec-rocket CLI。命令语义详见 SKILL.md。
#
# Usage:
#   ./trust-rocket init [项目名]
#   ./trust-rocket migrate [源目录]
#   ./trust-rocket preview [项目路径]
#   ./trust-rocket update [项目路径]
#   ./trust-rocket help

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEMPLATE="$SCRIPT_DIR/template"
VERSION="0.2.0"

print_usage() {
  cat <<EOF
TrustRocket CLI — 服务体系框架引导工具 (v$VERSION)

用法:
  ./trust-rocket init [项目名]      从 template/ 复制骨架（无参=当前目录，有参=新建目录）
  ./trust-rocket migrate [源目录]   迁移外部杂乱目录（复制归类，零数据丢失）
  ./trust-rocket preview [路径]     预览项目内容组织架构
  ./trust-rocket update [路径]      更新本地 skill + 升级项目
  ./trust-rocket help               显示本帮助

详情见 SKILL.md 与 trustrocket-convention.zh.md
EOF
}

cmd_init() {
  if [ ! -d "$TEMPLATE" ]; then
    echo "错误：找不到 template/ 目录。请确保已执行："
    echo "  git clone https://github.com/Toketec/TrustRocket.git"
    exit 1
  fi

  if [ $# -eq 0 ]; then
    TARGET_DIR="."
    echo "→ 在当前目录初始化骨架 ..."
  else
    NAME="$1"
    TARGET_DIR="${2:-$NAME}"
    if [ -d "$TARGET_DIR" ]; then
      echo "错误：目录 '$TARGET_DIR' 已存在"
      exit 1
    fi
    echo "→ 创建 $TARGET_DIR ..."
    mkdir -p "$TARGET_DIR"
  fi

  echo "→ 复制骨架 ..."
  shopt -s dotglob
  cp -r "$TEMPLATE"/* "$TARGET_DIR/"
  shopt -u dotglob

  cd "$TARGET_DIR"

  echo "→ 初始化 Git ..."
  git init
  git add .
  git commit -m "init: TrustRocket project skeleton"

  echo ""
  echo "✅ 骨架已就位！"
  echo ""
  echo "→ 引导式初始化（AI 执行 /trust-rocket init 时进行 4 问引导）："
  echo "  1. 项目叫什么名字？"
  echo "  2. 主要服务谁？"
  echo "  3. 主要做哪几块服务？"
  echo "  4. 有没有现成杂乱材料需要整理？"
  echo ""
  echo "骨架完成。下一步可用 /trust-rocket migrate 整理现成材料。"
}

cmd_migrate() {
  local SRC_DIR="${1:-}"

  if [ -z "$SRC_DIR" ]; then
    echo "用法: ./trust-rocket migrate <源目录>"
    echo "示例: ./trust-rocket migrate ~/Desktop/杂乱客服文件"
    exit 1
  fi

  if [ ! -d "$SRC_DIR" ]; then
    echo "错误：源目录不存在: $SRC_DIR"
    exit 1
  fi

  echo "→ 扫描源目录（只读，不修改任何文件）..."
  echo "  源目录: $SRC_DIR"
  echo ""

  # 只读扫描：列出所有文件（含隐藏文件），供 AI 分类
  echo "=== 文件清单 ==="
  find "$SRC_DIR" -type f | sort
  echo ""
  echo "=== 目录清单 ==="
  find "$SRC_DIR" -type d | sort
  echo ""

  echo "→ 扫描完成。以上文件需由 AI 按四大板块语义分类并复制归类。"
  echo ""
  echo "⚠️  迁移策略（务必遵守）："
  echo "  1. 复制，不移动 —— 源目录保留不动，绝不删除"
  echo "  2. 零数据丢失 —— 所有文件必须归类，判断不了的放入「待分类」，绝不丢弃"
  echo "  3. 核对确认 —— 迁移后生成映射表，与用户逐项核对无遗漏"
  echo ""
  echo "请交给 AI 执行 /trust-rocket migrate，完成分类、复制归类与核对。"
}

cmd_preview() {
  local TARGET="${1:-.}"

  if [ ! -d "$TARGET" ]; then
    echo "错误：路径不存在: $TARGET"
    exit 1
  fi

  echo "→ 扫描项目结构: $TARGET ..."
  echo ""

  # 检查是否 TrustRocket 项目（四大板块目录）
  local has_plates=0
  for plate in 装备材料 技术支持 案例沉淀 一线运营; do
    if [ -d "$TARGET/$plate" ]; then
      echo "  ✓ 检测到板块: $plate"
      has_plates=1
    fi
  done

  if [ -d "$TARGET/skills" ]; then
    echo "  ✓ 检测到目录: skills"
    has_plates=1
  fi

  echo ""

  if [ "$has_plates" -eq 0 ]; then
    echo "⚠️  当前目录不是 TrustRocket 项目（缺少四大板块目录）"
    echo "   建议先 /trust-rocket init 或 migrate"
    exit 1
  fi

  echo "→ 统计内容分布 ..."
  echo ""

  for plate in 装备材料 技术支持 案例沉淀 一线运营; do
    if [ -d "$TARGET/$plate" ]; then
      local count=$(find "$TARGET/$plate" -type f 2>/dev/null | wc -l | tr -d ' ')
      echo "  $plate: $count 个文件"
    fi
  done

  echo ""
  echo "→ 扫描完成。生成可视化预览页需由 AI 执行 /trust-rocket preview 完成。"
  echo "  AI 将基于上述结构生成 preview.html。"
}

cmd_update() {
  local TARGET="${1:-}"

  echo "→ 更新本地 TrustRocket skill（工具感知）..."
  echo ""
  echo "检测 AI 工具 ..."
  local tools_found=0

  if command -v hermes >/dev/null 2>&1; then
    echo "  ✓ 检测到 Hermes Agent"
    local hermes_dir="$HOME/.hermes/skills/trust-rocket"
    mkdir -p "$hermes_dir"
    cp "$SCRIPT_DIR/SKILL.md" "$hermes_dir/SKILL.md"
    echo "    → 已同步 SKILL.md 到 $hermes_dir/"
    tools_found=1
  fi

  if command -v claude >/dev/null 2>&1; then
    echo "  ✓ 检测到 Claude Code（项目级规则由 init/migrate 注入）"
    tools_found=1
  fi

  if [ "$tools_found" -eq 0 ]; then
    echo "  - 未检测到已知的 AI 工具（hermes/claude 等）"
    echo "  - 提示：TrustRocket 是纯文件约定，也可直接把 SKILL.md 注入为系统提示词"
  fi

  echo ""

  if [ -n "$TARGET" ] && [ -d "$TARGET" ]; then
    echo "→ 升级项目骨架: $TARGET ..."
    echo "  提示：只补充缺失骨架文件，不覆盖业务内容。由 AI 执行对比与补齐。"
  elif [ -n "$TARGET" ]; then
    echo "⚠️  项目路径不存在: $TARGET (跳过项目升级)"
  fi

  echo ""
  echo "✅ update 完成 (v$VERSION)"
}

case "${1:-help}" in
  init)
    shift
    cmd_init "$@"
    ;;
  migrate)
    shift
    cmd_migrate "$@"
    ;;
  preview)
    shift
    cmd_preview "$@"
    ;;
  update)
    shift
    cmd_update "$@"
    ;;
  help|--help|-h)
    print_usage
    ;;
  *)
    echo "未知命令: $1"
    echo ""
    print_usage
    exit 1
    ;;
esac
