@dataclass(frozen=True)
class Finding:
    severity: str
    code: str
    path: str
    message: str

    def render(self) -> str:
        icon = "错误" if self.severity == "error" else "警告"
        location = f" [{self.path}]" if self.path else ""
        return f"{icon} {self.code}{location}: {self.message}"


@dataclass
class HeadingNode:
    level: int
    line: int
    title: str
    has_child: bool = False
    has_direct_body: bool = False


def relative_display(path: Path, root: Path) -> str:
    try:
        return path.relative_to(root).as_posix()
    except ValueError:
        return str(path)


def is_ignored_internal_path(path: Path, root: Path) -> bool:
    try:
        parts = path.relative_to(root).parts
    except ValueError:
        return False
    return any(part in {".git", ".hg", ".svn", "__pycache__", "node_modules", ".venv"} for part in parts)


def is_within(path: Path, roots: set[Path]) -> bool:
    return any(path == root or root in path.parents for root in roots)


def configured_application_roots(root: Path, config: dict, findings: list[Finding] | None = None) -> set[Path]:
    roots: set[Path] = set()
    values = config.get("application_paths", [])
    if not isinstance(values, list):
        if findings is not None:
            findings.append(Finding("error", "TR006", ".trustrocket.json", "application_paths 必须是相对路径数组。"))
        return roots
    for value in values:
        if not isinstance(value, str):
            if findings is not None:
                findings.append(Finding("error", "TR006", ".trustrocket.json", "application_paths 中每项必须是字符串。"))
            continue
        relative = Path(value)
        if relative.is_absolute() or ".." in relative.parts or len(relative.parts) < 2 or relative.parts[0] not in DOMAINS:
            if findings is not None:
                findings.append(Finding("error", "TR007", value, "应用路径必须是位于四个业务域内的项目相对路径。"))
            continue
        absolute = root / relative
        if not absolute.is_dir():
            if findings is not None:
                findings.append(Finding("error", "TR008", value, "登记的应用目录不存在。"))
            continue
        roots.add(absolute.resolve())
    return roots


def looks_like_application_root(directory: Path, filenames: set[str], dirnames: list[str]) -> bool:
    if filenames & APPLICATION_MARKER_FILES:
        return True
    if any(name.endswith((".xcodeproj", ".xcworkspace")) for name in dirnames):
        return True
    if "index.html" in filenames and any(Path(name).suffix.lower() in {".js", ".ts", ".css"} for name in filenames):
        return True
    if any(Path(name).suffix.lower() in {".csproj", ".sln"} for name in filenames):
        return True
    return False


def application_roots(root: Path, domain_path: Path, config: dict, findings: list[Finding] | None = None) -> set[Path]:
    roots = {
        path for path in configured_application_roots(root, config, findings) if path == domain_path.resolve() or domain_path.resolve() in path.parents
    }
    for current, dirnames, filenames in os.walk(domain_path):
        current_path = Path(current).resolve()
        if is_within(current_path, roots) or Path(current).name in RESOURCE_DIRS:
            dirnames[:] = []
            continue
        dirnames[:] = [
            name
            for name in dirnames
            if name not in RESOURCE_DIRS and name not in {".git", ".hg", ".svn", "__pycache__", "node_modules", ".venv"}
        ]
        if looks_like_application_root(current_path, set(filenames), dirnames):
            roots.add(current_path)
            dirnames[:] = []
    return roots


def document_directories(root: Path, domain_path: Path, config: dict, findings: list[Finding] | None = None) -> Iterable[Path]:
    app_roots = application_roots(root, domain_path, config, findings)
    for current, dirnames, _ in os.walk(domain_path):
        current_path = Path(current).resolve()
        if is_within(current_path, app_roots) or Path(current).name in RESOURCE_DIRS:
            dirnames[:] = []
            continue
        dirnames[:] = [
            name
            for name in dirnames
            if name not in RESOURCE_DIRS and name not in {".git", ".hg", ".svn", "__pycache__", "node_modules", ".venv"}
        ]
        yield Path(current)


def iter_template_files() -> Iterable[Path]:
    return (path for path in TEMPLATE_ROOT.rglob("*") if path.is_file())


def copy_template(target: Path, missing_only: bool) -> list[str]:
    copied: list[str] = []
    for source in iter_template_files():
        relative = source.relative_to(TEMPLATE_ROOT)
        destination = target / relative
        if destination.exists():
            if missing_only:
                continue
            raise FileExistsError(f"目标已存在，拒绝覆盖: {destination}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        copied.append(relative.as_posix())
    return copied


def load_config_without_reporting(root: Path) -> dict:
    try:
        value = json.loads((root / ".trustrocket.json").read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, UnicodeError, json.JSONDecodeError):
        return {}


def ensure_markdown_resource_dirs(root: Path) -> list[str]:
    created: list[str] = []
    config = load_config_without_reporting(root)
    for domain in DOMAINS:
        domain_path = root / domain
        if not domain_path.is_dir():
            continue
        for directory in document_directories(root, domain_path, config):
            if not any(path.is_file() for path in directory.glob("*.md")):
                continue
            for resource_dir in RESOURCE_DIRS:
                target = directory / resource_dir
                if not target.exists():
                    target.mkdir()
                    (target / ".gitkeep").touch()
                    created.append(relative_display(target, root))
    return created


def ensure_valid_target(target: Path) -> None:
    if target.exists() and not target.is_dir():
        raise ValueError(f"目标不是目录: {target}")


def safe_relative_path(value: str, label: str) -> Path:
    path = Path(value)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        raise ValueError(f"{label}必须是项目内相对路径: {value}")
    return path


def resolve_domain(value: str) -> str:
    domain = DOMAIN_ALIASES.get(value)
    if domain is None:
        choices = "、".join(DOMAINS)
        raise ValueError(f"未知业务域 {value}；可使用 equipment/support/case/operations 或 {choices}")
    return domain


def write_project_config(root: Path, config: dict) -> None:
    (root / ".trustrocket.json").write_text(
        json.dumps(config, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def command_init(target: Path) -> int:
    ensure_valid_target(target)
    if not TEMPLATE_ROOT.is_dir():
        print(f"错误: 找不到模板目录 {TEMPLATE_ROOT}", file=sys.stderr)
        return 2
    if target.exists():
        remaining = [p for p in target.iterdir() if p.name not in IGNORABLE_EMPTY_ENTRIES]
        if remaining:
            print("错误: init 只接受不存在或为空的目录；已有项目请使用 migrate。", file=sys.stderr)
            return 2
    else:
        target.mkdir(parents=True)
    try:
        copied = copy_template(target, missing_only=False)
    except (OSError, ValueError) as exc:
        print(f"错误: 初始化失败: {exc}", file=sys.stderr)
        return 2
    print(f"TrustRocket 项目已初始化: {target.resolve()}")
    print(f"已创建 {len(copied)} 个最小骨架文件；未执行任何 Git 写操作。")
    return command_validate(target)


def classify_candidate(path: Path) -> str:
    name = path.name.lower()
    domain_keywords = (
        ("装备材料", ("指南", "手册", "sop", "faq", "培训", "验收", "部署", "配置", "操作", "checklist")),
        ("技术支持", ("故障", "问题", "工单", "诊断", "报错", "incident", "support", "log", "日志")),
        ("案例沉淀", ("案例", "复盘", "根因", "最佳实践", "经验", "case", "rca", "反模式")),
        ("一线运营", ("客户", "poc", "交付", "售后", "风险", "周报", "运营", "健康度", "续费", "sla")),
    )
    matches = [domain for domain, keywords in domain_keywords if any(keyword in name for keyword in keywords)]
    if len(matches) == 1:
        domain = matches[0]
        if path.suffix.lower() in TEXT_EXTENSIONS:
            return f"候选业务域: {domain}（需结合内容确认）"
        return f"候选原材料: {domain}内对应 Markdown 内容目录/source/（需确认来源与 user- 前缀）"
    if len(matches) > 1:
        return f"多个候选业务域: {'、'.join(matches)}（必须人工判断）"
    if path.suffix.lower() in BINARY_PACKAGING_EXTENSIONS:
        return "候选原材料: 某业务域内对应 Markdown 内容目录/source/（仅凭文件名无法判断业务域）"
    return "未能可靠分类，保持原位并读取内容后判断"


def normalization_suggestions(target: Path) -> list[tuple[str, str]]:
    known_root = set(REQUIRED_ROOT_FILES) | set(REQUIRED_PROJECT_DIRS) | {".gitignore", ".git"}
    suggestions: list[tuple[str, str]] = []
    for entry in sorted(target.iterdir(), key=lambda p: p.name):
        if entry.name in known_root or entry.name in IGNORABLE_EMPTY_ENTRIES:
            continue
        if entry.is_file():
            suggestions.append((entry.name, classify_candidate(entry)))
        elif entry.is_dir():
            suggestions.append((entry.name + "/", "非标准根目录；先理解用途，不自动移动或删除"))
    return suggestions


def command_normalize(target: Path, apply: bool) -> int:
    ensure_valid_target(target)
    if not target.is_dir():
        print(f"错误: 目标目录不存在: {target}", file=sys.stderr)
        return 2
    suggestions = normalization_suggestions(target)
    if apply:
        try:
            copied = copy_template(target, missing_only=True)
        except OSError as exc:
            print(f"错误: 安全补齐失败: {exc}", file=sys.stderr)
            return 2
        resources = ensure_markdown_resource_dirs(target)
        print(f"已安全补齐 {len(copied)} 个缺失骨架文件或占位，并为 {len(resources)} 个 Markdown 资源目录补齐 source/cut；未覆盖、移动、删除内容。")
    else:
        print("只读规范化分析；使用 --apply 仅补齐缺失骨架，不会移动现有内容。")
    if suggestions:
        print("现有内容候选归类:")
        for path, suggestion in suggestions:
            print(f"- {path}: {suggestion}")
    else:
        print("未发现需要候选归类的根部内容。")
    return command_validate(target)


def command_update() -> int:
    def run_git(*arguments: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            ["git", *arguments],
            cwd=FRAMEWORK_ROOT,
            text=True,
            capture_output=True,
            check=False,
        )

    inside = run_git("rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        print("错误: 当前 TrustRocket 不是 Git 克隆，无法自动更新。", file=sys.stderr)
        print("请使用 git clone 获取 TrustRocket；ZIP 解压目录不包含可更新的 Git 历史。", file=sys.stderr)
        return 2

    repository_root = run_git("rev-parse", "--show-toplevel")
    if repository_root.returncode != 0 or Path(repository_root.stdout.strip()).resolve() != FRAMEWORK_ROOT:
        print("错误: trust-rocket 不位于当前 Git 仓库根目录，拒绝更新其他仓库。", file=sys.stderr)
        return 2

    status = run_git("status", "--porcelain")
    if status.returncode != 0:
        print("错误: 无法读取 TrustRocket Git 状态。", file=sys.stderr)
        return 2
    if status.stdout.strip():
        print("错误: TrustRocket 工作区存在未提交修改；请先人工处理后再 update。", file=sys.stderr)
        return 2

    remote = run_git("remote", "get-url", "origin")
    if remote.returncode != 0 or "trustrocket" not in remote.stdout.strip().lower():
        print("错误: origin 不是可识别的 TrustRocket 远端。", file=sys.stderr)
        return 2

    before_commit = run_git("rev-parse", "HEAD")
    if before_commit.returncode != 0:
        print("错误: 无法读取当前 TrustRocket 版本。", file=sys.stderr)
        return 2

    shallow = run_git("rev-parse", "--is-shallow-repository")
    fetch_arguments = ["fetch", "origin", "--prune", "--tags"]
    if shallow.returncode == 0 and shallow.stdout.strip() == "true":
        fetch_arguments.insert(1, "--unshallow")
    fetched = run_git(*fetch_arguments)
    if fetched.returncode != 0:
        detail = fetched.stderr.strip() or fetched.stdout.strip()
        print(f"错误: 无法获取 TrustRocket 远端更新。{(' ' + detail) if detail else ''}", file=sys.stderr)
        return fetched.returncode

    default_branch = ""
    remote_head = run_git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if remote_head.returncode == 0 and remote_head.stdout.strip().startswith("origin/"):
        default_branch = remote_head.stdout.strip().removeprefix("origin/")
        remote_head_exists = run_git(
            "show-ref", "--verify", "--quiet", f"refs/remotes/origin/{default_branch}"
        )
        if remote_head_exists.returncode != 0:
            default_branch = ""
    if not default_branch:
        for candidate in ("main", "master"):
            exists = run_git("show-ref", "--verify", "--quiet", f"refs/remotes/origin/{candidate}")
            if exists.returncode == 0:
                default_branch = candidate
                break
    if not default_branch:
        print("错误: 无法确定 origin 的默认分支。", file=sys.stderr)
        return 2

    target = f"refs/remotes/origin/{default_branch}"
    ancestor = run_git("merge-base", "--is-ancestor", "HEAD", target)
    if ancestor.returncode == 1:
        print("错误: 本地历史与远端默认分支已分叉，不能安全快进更新。", file=sys.stderr)
        print("本地内容未被强制覆盖；请人工处理本地提交后重试。", file=sys.stderr)
        return 2
    if ancestor.returncode != 0:
        print("错误: 无法确认本地与远端的版本关系。", file=sys.stderr)
        return 2

    merged = run_git("merge", "--ff-only", target)
    if merged.returncode != 0:
        detail = merged.stderr.strip() or merged.stdout.strip()
        print(f"错误: 快进更新失败。{(' ' + detail) if detail else ''}", file=sys.stderr)
        print("本地内容未被强制覆盖。", file=sys.stderr)
        return merged.returncode

    after_commit = run_git("rev-parse", "HEAD")
    updated_cli = FRAMEWORK_ROOT / "trust-rocket"
    version_result = subprocess.run(
        [sys.executable, str(updated_cli), "--version"],
        cwd=FRAMEWORK_ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    actual_version = version_result.stdout.strip() if version_result.returncode == 0 else "TrustRocket 未知版本"

    validation = subprocess.run(
        [sys.executable, str(updated_cli), "validate", str(TEMPLATE_ROOT)],
        cwd=FRAMEWORK_ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if validation.returncode != 0:
        detail = validation.stdout.strip() or validation.stderr.strip()
        print(f"错误: 框架已快进，但新版本模板校验失败。{(' ' + detail) if detail else ''}", file=sys.stderr)
        return validation.returncode

    before_short = before_commit.stdout.strip()[:7]
    after_short = after_commit.stdout.strip()[:7] if after_commit.returncode == 0 else "unknown"
    if before_short == after_short:
        print(f"TrustRocket 已是最新版本: {actual_version}")
    else:
        print(f"TrustRocket 更新完成: {VERSION} -> {actual_version.removeprefix('TrustRocket ')}")
        print(f"提交: {before_short} -> {after_short}")
    print(validation.stdout.strip())
    print("框架仓库已完整更新；已有业务项目未被自动覆盖。")
    return 0


def require_project(root: Path) -> dict:
    ensure_valid_target(root)
    if not root.is_dir() or not (root / ".trustrocket.json").is_file():
        raise ValueError(f"目标不是 TrustRocket 业务项目: {root}")
    config = load_config_without_reporting(root)
    if not config:
        raise ValueError(f"无法读取项目配置: {root / '.trustrocket.json'}")
    return config


def command_document(project: Path, domain_value: str, relative_value: str, title: str | None) -> int:
    config = require_project(project)
    domain = resolve_domain(domain_value)
    relative = safe_relative_path(relative_value, "文档路径")
    if any(part in RESOURCE_DIRS for part in relative.parts):
        raise ValueError("业务 Markdown 不能创建在 source/ 或 cut/ 中。")
    if relative.suffix.lower() != ".md":
        relative = relative.with_suffix(".md")
    target = project / domain / relative
    app_roots = application_roots(project, project / domain, config)
    if is_within(target.parent.resolve(), app_roots):
        raise ValueError("document 命令不用于应用代码树内部的 Markdown。")
    if target.exists():
        raise ValueError(f"文档已存在，拒绝覆盖: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(f"# {title or target.stem}\n", encoding="utf-8")
    for resource_dir in RESOURCE_DIRS:
        directory = target.parent / resource_dir
        directory.mkdir(exist_ok=True)
        (directory / ".gitkeep").touch(exist_ok=True)
    print(f"已创建 Markdown 内容: {relative_display(target, project)}")
    print(f"已配套资源目录: {relative_display(target.parent / 'source', project)}、{relative_display(target.parent / 'cut', project)}")
    return command_validate(project)


def command_app(project: Path, domain_value: str, relative_value: str) -> int:
    config = require_project(project)
    domain = resolve_domain(domain_value)
    relative = safe_relative_path(relative_value, "应用路径")
    if any(part in RESOURCE_DIRS for part in relative.parts):
        raise ValueError("应用目录不能位于 source/ 或 cut/ 中。")
    target = project / domain / relative
    if target.exists() and not target.is_dir():
        raise ValueError(f"应用路径已被文件占用: {target}")
    created = not target.exists()
    target.mkdir(parents=True, exist_ok=True)
    if created:
        (target / ".gitkeep").touch()
    registered_path = Path(domain, relative).as_posix()
    values = config.setdefault("application_paths", [])
    if not isinstance(values, list):
        raise ValueError(".trustrocket.json 的 application_paths 不是数组。")
    if registered_path not in values:
        values.append(registered_path)
        values.sort()
        write_project_config(project, config)
    action = "创建并登记" if created else "登记"
    print(f"已{action}应用目录: {registered_path}")
    return command_validate(project)


def command_material(project: Path, relative_value: str, origin: str, approved_binary: bool) -> int:
    config = require_project(project)
    relative = safe_relative_path(relative_value, "素材路径")
    target = project / relative
    if not target.is_file():
        raise ValueError(f"素材文件不存在: {target}")
    if origin == "user" and not target.name.startswith("user-"):
        raise ValueError("用户素材及其切出资源必须使用 user- 前缀。")
    if origin == "public" and target.name.startswith("user-"):
        raise ValueError("公共素材不得使用 user- 前缀。")
    if origin == "generated" and target.suffix.lower() in BINARY_PACKAGING_EXTENSIONS and not approved_binary:
        raise ValueError("生成型二进制必须显式使用 --approved-binary。")
    materials = config.setdefault("materials", {})
    if not isinstance(materials, dict):
        raise ValueError(".trustrocket.json 的 materials 不是对象。")
    record: dict[str, object] = {"origin": origin}
    if approved_binary:
        record["approved_binary"] = True
    materials[relative.as_posix()] = record
    write_project_config(project, config)
    print(f"已登记素材: {relative.as_posix()} ({origin})")
    return command_validate(project)


def read_json_config(root: Path, findings: list[Finding]) -> dict:
    config_path = root / ".trustrocket.json"
    if not config_path.is_file():
        findings.append(Finding("error", "TR001", ".trustrocket.json", "缺少机器配置入口。"))
        return {}
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        findings.append(Finding("error", "TR002", ".trustrocket.json", f"配置不是有效 JSON: {exc}"))
        return {}
    if config.get("domains") != list(DOMAINS):
        findings.append(Finding("error", "TR003", ".trustrocket.json", "domains 必须且只能按标准顺序包含四个业务域。"))
    if config.get("content_model") != "markdown-scoped-source-cut":
        findings.append(Finding("error", "TR004", ".trustrocket.json", "content_model 必须为 markdown-scoped-source-cut。"))
    if not isinstance(config.get("materials", {}), dict):
        findings.append(Finding("error", "TR005", ".trustrocket.json", "materials 必须是路径到来源信息的对象。"))
    configured_application_roots(root, config, findings)
    return config


def validate_structure(root: Path, config: dict, findings: list[Finding]) -> None:
    for required in REQUIRED_ROOT_FILES:
        if not (root / required).is_file():
            findings.append(Finding("error", "TR010", required, "缺少 TrustRocket 项目入口文件。"))
    if not (root / "skills").is_dir():
        findings.append(Finding("error", "TR013", "skills", "缺少项目级 Skill 目录。"))
    for domain in DOMAINS:
        domain_path = root / domain
        if not domain_path.is_dir():
            findings.append(Finding("error", "TR011", domain, "缺少标准业务域目录。"))
            continue
        for directory in document_directories(root, domain_path, config):
            has_markdown = any(path.is_file() for path in directory.glob("*.md"))
            existing_resources = [name for name in RESOURCE_DIRS if (directory / name).is_dir()]
            if has_markdown:
                for resource_dir in RESOURCE_DIRS:
                    if not (directory / resource_dir).is_dir():
                        findings.append(
                            Finding(
                                "error",
                                "TR012",
                                relative_display(directory / resource_dir, root),
                                "当前目录直接包含 Markdown，必须同时存在 source/ 和 cut/。",
                            )
                        )
            elif existing_resources:
                findings.append(
                    Finding(
                        "warning",
                        "TR015",
                        relative_display(directory, root),
                        "当前目录没有直接包含 Markdown，默认不需要 source/ 或 cut/。",
                    )
                )


def validate_project_skills(root: Path, findings: list[Finding]) -> None:
    skills_root = root / "skills"
    if not skills_root.is_dir():
        return
    for entry in sorted(skills_root.iterdir(), key=lambda path: path.name):
        if entry.name == ".gitkeep":
            continue
        if not entry.is_dir():
            findings.append(
                Finding("error", "TR060", relative_display(entry, root), "skills/ 下每个 Skill 必须使用独立目录。")
            )
            continue
        if not (entry / "SKILL.md").is_file():
            findings.append(
                Finding("error", "TR061", relative_display(entry, root), "已沉淀的 Skill 缺少 SKILL.md 入口。")
            )


def parse_markdown(path: Path, root: Path, findings: list[Finding]) -> None:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as exc:
        findings.append(Finding("error", "TR020", relative_display(path, root), f"无法读取 Markdown: {exc}"))
        return
    nodes: list[HeadingNode] = []
    stack: list[HeadingNode] = []
    in_fence = False
    fence_marker = ""
    for line_number, line in enumerate(lines, start=1):
        stripped = line.lstrip()
        fence = re.match(r"^(```+|~~~+)", stripped)
        if fence:
            marker = fence.group(1)[0]
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif marker == fence_marker:
                in_fence = False
                fence_marker = ""
            if stack:
                stack[-1].has_direct_body = True
            continue
        if in_fence:
            if stripped and stack:
                stack[-1].has_direct_body = True
            continue
        heading = re.match(r"^(#{1,6})\s+(.*?)\s*$", line)
        if heading:
            level = len(heading.group(1))
            title = heading.group(2)
            if level > 3:
                findings.append(
                    Finding(
                        "error",
                        "TR021",
                        f"{relative_display(path, root)}:{line_number}",
                        f"业务 Markdown 最多三级标题，发现 {level} 级标题。",
                    )
                )
            while stack and stack[-1].level >= level:
                stack.pop()
            if stack:
                if level > stack[-1].level + 1:
                    findings.append(
                        Finding(
                            "error",
                            "TR022",
                            f"{relative_display(path, root)}:{line_number}",
                            "标题层级发生跳跃。",
                        )
                    )
                stack[-1].has_child = True
            elif level > 1:
                findings.append(
                    Finding(
                        "error",
                        "TR022",
                        f"{relative_display(path, root)}:{line_number}",
                        "文档顶层标题必须从一级开始。",
                    )
                )
            node = HeadingNode(level=level, line=line_number, title=title)
            nodes.append(node)
            stack.append(node)
            continue
        if stripped:
            if stack:
                stack[-1].has_direct_body = True
            else:
                findings.append(
                    Finding(
                        "error",
                        "TR023",
                        f"{relative_display(path, root)}:{line_number}",
                        "正文出现在首个标题之前。",
                    )
                )
    if not nodes:
        findings.append(Finding("warning", "TR024", relative_display(path, root), "业务 Markdown 没有标题。"))
    for node in nodes:
        if node.has_child and node.has_direct_body:
            findings.append(
                Finding(
                    "error",
                    "TR025",
                    f"{relative_display(path, root)}:{node.line}",
                    f"非叶子标题“{node.title}”直接承载正文。",
                )
            )


def validate_markdown(root: Path, config: dict, findings: list[Finding]) -> None:
    for domain in DOMAINS:
        domain_path = root / domain
        if not domain_path.is_dir():
            continue
        for directory in document_directories(root, domain_path, config):
            for path in directory.glob("*.md"):
                parse_markdown(path, root, findings)
            for resource_dir in RESOURCE_DIRS:
                resource_path = directory / resource_dir
                if resource_path.is_dir():
                    for markdown in resource_path.rglob("*.md"):
                        findings.append(
                            Finding(
                                "warning",
                                "TR026",
                                relative_display(markdown, root),
                                "source/ 与 cut/ 原则上不主动保存业务 Markdown。",
                            )
                        )


def normalize_material_record(record: object) -> tuple[str | None, bool]:
    if isinstance(record, str):
        return record, False
    if isinstance(record, dict):
        origin = record.get("origin")
        approved_binary = record.get("approved_binary", False)
        return origin if isinstance(origin, str) else None, approved_binary is True
    return None, False


def validate_materials(root: Path, config: dict, findings: list[Finding]) -> None:
    materials = config.get("materials", {})
    if not isinstance(materials, dict):
        return
    registered: set[str] = set()
    for relative, record in materials.items():
        if not isinstance(relative, str):
            findings.append(Finding("error", "TR030", ".trustrocket.json", "materials 的键必须是相对路径字符串。"))
            continue
        registered.add(Path(relative).as_posix())
        material_path = Path(relative)
        if material_path.is_absolute() or ".." in material_path.parts:
            findings.append(Finding("error", "TR031", relative, "素材登记必须使用项目内相对路径。"))
            continue
        if (
            len(material_path.parts) < 3
            or material_path.parts[0] not in DOMAINS
            or not any(part in RESOURCE_DIRS for part in material_path.parts[1:-1])
        ):
            findings.append(
                Finding("error", "TR038", relative, "素材必须登记在某个 Markdown 内容目录同级的 source/ 或 cut/ 中。")
            )
        absolute = root / material_path
        if len(material_path.parts) >= 3 and material_path.parts[0] in DOMAINS:
            resource_indexes = [
                index for index, part in enumerate(material_path.parts[1:-1], start=1) if part in RESOURCE_DIRS
            ]
            if resource_indexes:
                resource_index = resource_indexes[0]
                content_directory = root.joinpath(*material_path.parts[:resource_index])
                if not any(path.is_file() for path in content_directory.glob("*.md")):
                    findings.append(
                        Finding("error", "TR038", relative, "source/ 或 cut/ 的同级内容目录必须直接包含 Markdown。")
                    )
                app_roots = application_roots(root, root / material_path.parts[0], config)
                if is_within(absolute.resolve(), app_roots):
                    findings.append(
                        Finding("error", "TR038", relative, "应用代码树不使用 TrustRocket 文档素材登记。")
                    )
        origin, approved_binary = normalize_material_record(record)
        if origin not in {"user", "public", "generated"}:
            findings.append(Finding("error", "TR032", relative, "origin 必须是 user、public 或 generated。"))
        basename = material_path.name
        if origin == "user" and not basename.startswith("user-"):
            findings.append(Finding("error", "TR033", relative, "用户素材及其切出资源必须使用 user- 前缀。"))
        if origin == "public" and basename.startswith("user-"):
            findings.append(Finding("error", "TR034", relative, "公共素材不得使用 user- 前缀。"))
        if origin == "generated" and absolute.suffix.lower() in BINARY_PACKAGING_EXTENSIONS and not approved_binary:
            findings.append(
                Finding("error", "TR035", relative, "生成型二进制未登记 approved_binary: true。默认应使用文本。")
            )
        if not absolute.is_file():
            findings.append(Finding("error", "TR036", relative, "素材登记指向的文件不存在。"))
    for domain in DOMAINS:
        domain_path = root / domain
        if not domain_path.is_dir():
            continue
        for directory in document_directories(root, domain_path, config):
            for resource_dir in RESOURCE_DIRS:
                resource_path = directory / resource_dir
                if not resource_path.is_dir():
                    continue
                for file_path in resource_path.rglob("*"):
                    if not file_path.is_file() or file_path.name == ".gitkeep":
                        continue
                    relative = relative_display(file_path, root)
                    if relative not in registered:
                        findings.append(
                            Finding("warning", "TR037", relative, "素材未在 .trustrocket.json 的 materials 中登记来源。")
                        )


def validate_state_files(root: Path, findings: list[Finding]) -> None:
    for path in root.rglob("*"):
        if is_ignored_internal_path(path, root):
            continue
        if path.is_file() and path.name.lower() in FRAMEWORK_STATE_NAMES:
            findings.append(
                Finding(
                    "error",
                    "TR040",
                    relative_display(path, root),
                    "禁止维护 TrustRocket 自身进度、工作日志、待办或路线图状态文件。",
                )
            )


def is_under_source(path: Path, root: Path) -> bool:
    try:
        parts = path.relative_to(root).parts
    except ValueError:
        return False
    return len(parts) >= 3 and parts[0] in DOMAINS and "source" in parts[1:-1]


def validate_personal_config(root: Path, findings: list[Finding]) -> None:
    for path in root.rglob("*"):
        if is_ignored_internal_path(path, root):
            continue
        if not path.is_file() or path.name == ".gitkeep":
            continue
        if path.suffix.lower() not in TEXT_EXTENSIONS and path.name != "AGENTS.md":
            continue
        try:
            if path.stat().st_size > 2_000_000:
                continue
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        for label, pattern in PERSONAL_CONFIG_PATTERNS:
            match = pattern.search(text)
            if not match:
                continue
            line = text.count("\n", 0, match.start()) + 1
            severity = "warning" if is_under_source(path, root) else "error"
            message = f"发现{label}，不得沉淀个人环境配置。"
            if severity == "warning":
                message += " 原始诊断材料请限制访问，并在复用前脱敏。"
            findings.append(
                Finding(severity, "TR050", f"{relative_display(path, root)}:{line}", message)
            )


def validate_project(root: Path) -> list[Finding]:
    findings: list[Finding] = []
    config = read_json_config(root, findings)
    validate_structure(root, config, findings)
    validate_project_skills(root, findings)
    validate_markdown(root, config, findings)
    validate_materials(root, config, findings)
    validate_state_files(root, findings)
    validate_personal_config(root, findings)
    return findings


def command_validate(target: Path) -> int:
    ensure_valid_target(target)
    if not target.is_dir():
        print(f"错误: 目标目录不存在: {target}", file=sys.stderr)
        return 2
    findings = validate_project(target)
    errors = [finding for finding in findings if finding.severity == "error"]
    warnings = [finding for finding in findings if finding.severity == "warning"]
    for finding in findings:
        print(finding.render())
    if errors:
        print(f"校验失败: {len(errors)} 个错误，{len(warnings)} 个警告。")
        return 1
    print(f"校验通过: 0 个错误，{len(warnings)} 个警告。")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="trust-rocket",
        description="TrustRocket 项目初始化、开发辅助与契约校验工具",
    )
    parser.add_argument("--version", action="version", version=f"TrustRocket {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="在不存在或空目录创建最小业务项目")
    init_parser.add_argument("target", type=Path, nargs="?", default=Path("."))
    migrate_parser = subparsers.add_parser("migrate", help="分析已有项目并可安全补齐骨架")
    migrate_parser.add_argument("target", type=Path, nargs="?", default=Path("."))
    migrate_parser.add_argument("--apply", action="store_true", help="只补齐缺失骨架，不移动、删除或覆盖")

    subparsers.add_parser("update", help="完整获取 origin 并安全快进到最新 TrustRocket")

    document_parser = subparsers.add_parser("document", help="创建 Markdown 内容并配套 source/cut")
    document_parser.add_argument("domain", help="equipment/support/case/operations 或中文业务域")
    document_parser.add_argument("path", help="业务域内相对路径；可省略 .md")
    document_parser.add_argument("--title", help="一级标题；默认使用文件名")
    document_parser.add_argument("--project", type=Path, default=Path("."), help="TrustRocket 业务项目路径")

    app_parser = subparsers.add_parser("app", help="创建或登记业务域内的应用目录")
    app_parser.add_argument("domain", help="equipment/support/case/operations 或中文业务域")
    app_parser.add_argument("path", help="业务域内应用相对路径")
    app_parser.add_argument("--project", type=Path, default=Path("."), help="TrustRocket 业务项目路径")

    material_parser = subparsers.add_parser("material", help="登记已存在的 source/cut 素材")
    material_parser.add_argument("path", help="项目根目录下的素材相对路径")
    material_parser.add_argument("--origin", choices=("user", "public", "generated"), required=True)
    material_parser.add_argument("--approved-binary", action="store_true", help="明确批准生成型二进制")
    material_parser.add_argument("--project", type=Path, default=Path("."), help="TrustRocket 业务项目路径")

    validate_parser = subparsers.add_parser("validate", help="只读校验 TrustRocket 业务项目")
    validate_parser.add_argument("target", type=Path, nargs="?", default=Path("."))
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        if args.command == "init":
            return command_init(args.target)
        if args.command == "migrate":
            return command_normalize(args.target, args.apply)
        if args.command == "update":
            return command_update()
        if args.command == "document":
            return command_document(args.project, args.domain, args.path, args.title)
        if args.command == "app":
            return command_app(args.project, args.domain, args.path)
        if args.command == "material":
            return command_material(args.project, args.path, args.origin, args.approved_binary)
        if args.command == "validate":
            return command_validate(args.target)
    except (OSError, ValueError) as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 2
    parser.error("未知命令")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
