#!/usr/bin/env python3
"""TrustRocket project bootstrap, helper commands, and validator.

Init, migrate, helper, and validation commands do not create commits or push.
Migration only adds missing framework entries and directories; it never moves,
deletes, or overwrites existing user content. Update is an explicit fast-forward
pull and refuses to run when the framework worktree is dirty.
"""

from __future__ import annotations

