{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocketos.local/trustrocket/handoff.schema.json",
  "title": "TrustRocket Handoff Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "type",
    "source",
    "target",
    "trigger",
    "inputs",
    "outputs",
    "acceptance",
    "owner_role",
    "sensitivity"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^tr-ho-[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "type": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/stringList"},
    "outputs": {"$ref": "#/$defs/stringList"},
    "acceptance": {"$ref": "#/$defs/stringList"},
    "owner_role": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["public", "internal", "customer-confidential", "restricted"]}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
